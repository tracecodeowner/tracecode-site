{
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "topup",
        "usage",
        "refund",
        "admin_adjustment"
      ],
      "description": "Type of credit transaction"
    },
    "credits": {
      "type": "number",
      "description": "Credits added (positive) or spent (negative)"
    },
    "remainingBalance": {
      "type": "number",
      "description": "Remaining credit balance after this transaction"
    },
    "package": {
      "type": "string",
      "description": "Package key for top-up transactions"
    },
    "amountUsd": {
      "type": "number",
      "description": "USD amount paid (for top-up transactions)"
    },
    "description": {
      "type": "string",
      "description": "Transaction description"
    },
    "paymentStatus": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "description": "Payment status for top-up transactions"
    }
  },
  "required": [
    "action",
    "credits",
    "remainingBalance"
  ],
  "name": "CreditTransaction",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}